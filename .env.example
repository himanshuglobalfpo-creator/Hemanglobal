# Copy to .env (or export in your process manager) and edit.
# REQUIRED in production — encrypts TOTP secrets at rest (any long random string):
VAULT_KEY=change-me-to-a-long-random-string

# HTTP
PORT=3000
NODE_ENV=production

# Storage
DATA_DIR=./data
# DB_PATH=./data/ledgerlite.db

# Attachments: "local" (default) or "s3"
FILE_STORAGE=local
# FILE_DIR=./data/uploads
# S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# S3_BUCKET=ledgerlite-attachments
# S3_KEY=...
# S3_SECRET=...
# S3_REGION=us-east-1
