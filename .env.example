# =============================================================================
# LedgerLite — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values for the services you use.
# Items marked OPTIONAL are not required to boot — the related feature is
# disabled gracefully until configured.

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=5000

# Public URL the app is served from. Used in invoice share links and as the
# default for Stripe success/cancel URLs. Include the protocol but no trailing slash.
APP_BASE_URL=http://localhost:5000

# PostgreSQL connection string. Format: postgresql://user:pass@host:5432/dbname
# With docker-compose, the postgres service is reachable at host "postgres".
DATABASE_URL=postgresql://user:pass@localhost:5432/ledgerlite

# Connection pool bounds (optional — defaults shown)
PG_POOL_MIN=2
PG_POOL_MAX=10

# -----------------------------------------------------------------------------
# Email (SMTP)  — OPTIONAL
# -----------------------------------------------------------------------------
# When unset, email-sending features (send-invoice, password reset) log to
# stdout instead. The app still functions; users just don't receive emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LedgerLite <noreply@example.com>"
SMTP_SECURE=false   # true for port 465

# -----------------------------------------------------------------------------
# Stripe (online invoice payments)  — OPTIONAL
# -----------------------------------------------------------------------------
# Without these, the "Pay online" link on the public share page returns a
# graceful 503 with a message. Webhook secret is required for the webhook
# endpoint to verify Stripe signatures.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Override the success URL if you want to redirect somewhere other than the
# share page after a successful payment. Defaults to ${APP_BASE_URL}/p/invoice/{token}?paid=1
# STRIPE_SUCCESS_URL=

# -----------------------------------------------------------------------------
# Plaid (bank connections)  — OPTIONAL
# -----------------------------------------------------------------------------
# Without these, /api/plaid/* returns 503. Bank import via CSV continues to work.
PLAID_CLIENT_ID=
PLAID_SECRET=
PLAID_ENV=sandbox    # sandbox | development | production
# Public URL Plaid will POST sync notifications to. Optional — without it, you
# must trigger /api/plaid/items/:id/sync manually (or via cron).
# PLAID_WEBHOOK_URL=https://your-domain.com/api/plaid/webhook

# -----------------------------------------------------------------------------
# File storage (attachment blobs)  — OPTIONAL
# -----------------------------------------------------------------------------
# Attachment file bytes are ALWAYS encrypted at rest with AES-256-GCM before
# they reach the driver (the vault key never leaves the app — see
# APP_ENCRYPTION_KEY). The driver only ever stores ciphertext.
#
# FILE_STORAGE=local (default) keeps blobs under FILE_DIR. FILE_STORAGE=s3 uses
# any S3-compatible store (AWS S3, Cloudflare R2, or MinIO for local dev) via
# SigV4 — no AWS SDK. To move an existing install from local disk to S3, set
# these, deploy, then POST /api/attachments/migrate (owner) until remaining=0;
# reads keep working throughout (each blob is served from the store it lives on).
FILE_STORAGE=local            # local | s3
FILE_DIR=./data/uploads       # local driver root
# The docker-compose `minio` service provides these defaults for local dev:
S3_ENDPOINT=                  # e.g. http://localhost:9000 (MinIO) or https://s3.us-east-1.amazonaws.com
S3_BUCKET=ledgerlite-attachments
S3_KEY=
S3_SECRET=
S3_REGION=us-east-1

# -----------------------------------------------------------------------------
# Auth / sessions
# -----------------------------------------------------------------------------
# Session cookies are HttpOnly + SameSite=Lax. In production, set NODE_ENV=production
# so the Secure flag is also set automatically.

# -----------------------------------------------------------------------------
# TaxJar (automated US sales tax)  — OPTIONAL
# -----------------------------------------------------------------------------
# When unset, invoices use the manual tax_codes rate exactly as before, with a
# warning logged. When set, invoice creation calculates destination-based tax
# automatically for customers with a shipping ZIP + state, gated by the org's
# nexus states (/api/tax/nexus). TaxJar failures never block invoice creation —
# the app falls back to the manual rate and logs a warning.
TAXJAR_API_KEY=          # From TaxJar dashboard
TAXJAR_SANDBOX=true      # true for testing (api.sandbox.taxjar.com), false for production
